@page
@model AdminPanel.Pages.Faucet4u.SettingsModel
@{
    ViewData["Title"] = "Settings";
    Layout = "Faucet4u_Layout";
}

<div class="row" style="margin-top: 10%;">
    <div class="col-3"></div>
    <div class="col">
        <span class="text-success">@ViewData["Success"]</span>
        <span class="text-danger">@ViewData["Failed"]</span>
        <span class="text-danger">@ViewData["Error"]</span>
        <br />
        <!--Value -- Replace -->
        <form asp-page-handler="ReplaceValue" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Replace</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Name</span>
                </div>
                <input type="text" class="form-control" placeholder="Name" name="name" aria-label="Name" aria-describedby="basic-addon1">
                <input type="text" class="form-control" name="value" aria-label="Value" aria-describedby="basic-addon1">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Value</span>
                </div>
            </div>

        </form>

        <p hidden id="tableData">@ViewData["TableData"]</p>

        <table id="dtBasicExample" class="table table-striped table-bordered" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th class="th-sm">
                        Setting Name
                    </th>
                    <th class="th-sm">
                        Setting Value
                    </th>
                </tr>
            </thead>
            <tbody id="tableBody"></tbody>
            <tfoot>
                <tr>
                    <th>
                        Setting Name
                    </th>
                    <th>
                        Setting Value
                    </th>
                </tr>
            </tfoot>
        </table>

        <script>
            $(document).ready(function () {
                $('#dtBasicExample').DataTable();
                $('.dataTables_length').addClass('bs-select');
            });

            var tableData = JSON.parse(document.getElementById('tableData').innerHTML);

            for (i = 0; i < Object.keys(tableData).length; i++) {

                document.getElementById("tableBody").insertAdjacentHTML('beforeend',
                    '<tr><td class="clickableTableData" onClick="updateNameInput(this.innerHTML)">' + tableData[i].Name +
                    '</td><td class="clickableTableData" onClick="updateValueInput(this.innerHTML)">' + tableData[i].Value +
                    '</td></tr>');

            }

            function updateNameInput(name) {

                $('input[name=name]').val(name);
                window.scrollTo(0, 0);
            }

            function updateValueInput(value) {

                $('input[name=value]').val(value);
                window.scrollTo(0, 0);
            }

        </script>
    </div>
    <div class="col-3"></div>
</div>
