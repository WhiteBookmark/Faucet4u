@page
@model AdminPanel.Pages.MiningModel
@{
    ViewData["Title"] = "Mining";
    Layout = "Faucet4u_Layout";
}

<div class="row" style="margin-top: 10%;">
    <div class="col-3"></div>
    <div class="col">
        <span class="text-success">@ViewData["Success"]</span>
        <span class="text-danger">@ViewData["Failed"]</span>
        <span class="text-danger">@ViewData["Error"]</span>
        <br />

        <!-- Mining Percentage-- Update-->
        <form asp-page-handler="UpdatePercentage" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Update</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Percentage</span>
                </div>
                <input type="text" class="form-control" placeholder="Percentage in number, like 20 for 20%" name="percentage" aria-label="Percentage" aria-describedby="basic-addon1">
            </div>
        </form>   

        <p hidden id="tableData">@ViewData["TableData"]</p>

        <table id="dtBasicExample" class="table table-striped table-bordered" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th class="th-sm">
                        CPU Percentage
                    </th>                   
                </tr>
            </thead>
            <tbody id="tableBody"></tbody>
            <tfoot>
                <tr>
                    <th>
                        CPU Percentage
                    </th>                 
                </tr>
            </tfoot>
        </table>

        <script>
            $(document).ready(function () {
                $('#dtBasicExample').DataTable();
                $('.dataTables_length').addClass('bs-select');
            });

            var tableData = JSON.parse(document.getElementById('tableData').innerHTML);

            for (i = 0; i < Object.keys(tableData).length; i++) {

                document.getElementById("tableBody").insertAdjacentHTML('beforeend', '<tr><td>' + tableData[i].Percentage + '</td></tr>');

            }

        </script>


    </div>
    <div class="col-3"></div>


</div>
