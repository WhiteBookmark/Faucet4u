@page
@model AdminPanel.Pages.Faucet4u.DirectModel
@{
    ViewData["Title"] = "Direct";
    Layout = "Faucet4u_Layout";
}


<div class="row" style="margin-top: 10%;">
    <div class="col-3"></div>
    <div class="col">
        <span class="text-success">@ViewData["Success"]</span>
        <span class="text-danger">@ViewData["Failed"]</span>
        <span class="text-danger">@ViewData["Error"]</span>
        <br />
        <!-- Direct-- Add-->
        <form asp-page-handler="AddDirect" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Add</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Direct Link</span>
                </div>
                <input type="text" class="form-control" placeholder="Link" name="link" aria-label="Link" aria-describedby="basic-addon1">
            </div>
        </form>

        <!-- Direct-- Delete-->
        <form asp-page-handler="DeleteDirect" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Delete</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Direct Link ID</span>
                </div>
                <input type="text" class="form-control" placeholder="ID" name="id" aria-label="ID" aria-describedby="basic-addon1">
            </div>
        </form>


        <p hidden id="tableData">@ViewData["TableData"]</p>

        <table id="dtBasicExample" class="table table-striped table-bordered" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th class="th-sm">
                        Id
                    </th>
                    <th class="th-sm">
                        Link
                    </th>
                    <th class="th-sm">
                        Hits Received
                    </th>

                </tr>
            </thead>
            <tbody id="tableBody"></tbody>
            <tfoot>
                <tr>
                    <th>
                        Id
                    </th>
                    <th>
                        Link
                    </th>
                    <th>
                        Hits Received
                    </th>
                </tr>
            </tfoot>
        </table>

        <script>
            $(document).ready(function () {
                $('#dtBasicExample').DataTable();
                $('.dataTables_length').addClass('bs-select');
            });

            var tableData = JSON.parse(document.getElementById('tableData').innerHTML);

            for (i = 0; i < Object.keys(tableData).length; i++) {

                document.getElementById("tableBody").insertAdjacentHTML('beforeend',
                    '<tr><td>' + tableData[i].Id +
                    '</td><td>' + tableData[i].Link +
                    '</td><td>' + tableData[i].HitsReceived +
                    '</td></tr>');

            }

        </script>


    </div>
    <div class="col-3"></div>


</div>

