@page
@model AdminPanel.Pages.Faucet4u.UsersModel
@{
    ViewData["Title"] = "Users";
    Layout = "Faucet4u_Layout";
}


<div class="row" style="margin-top: 10%;">
    <div class="col-0"></div>
    <div class="col">
        <span class="text-success">@ViewData["Success"]</span>
        <span class="text-danger">@ViewData["Failed"]</span>
        <span class="text-danger">@ViewData["Error"]</span>
        <br />

        <p hidden id="tableData">@ViewData["TableData"]</p>

        <table id="dtBasicExample" class="table table-striped table-bordered ordering searching paging scrollX" cellspacing="0">
            <thead>
                <tr>
                    <th class="th-sm">
                        Username
                    </th>
                    <th class="th-sm">
                        Email
                    </th>
                    <th class="th-sm">
                        Email Confirmed
                    </th>
                    <th class="th-sm">
                        Date Registered
                    </th>
                    <th class="th-sm">
                        Registration IP
                    </th>
                    <th class="th-sm">
                        Country
                    </th>
                    <th class="th-sm">
                        FaucetHub Bitcoin Address
                    </th>
                    <th class="th-sm">
                        Account Locked
                    </th>
                    <th class="th-sm">
                        Cheat Counter
                    </th>
                    <th class="th-sm">
                        Referrer
                    </th>
                    <th class="th-sm">
                        Balance
                    </th>
                    <th class="th-sm">
                        Offerwall Balance
                    </th>
                    <th class="th-sm">
                        Purchase Balance
                    </th>
                    <th class="th-sm">
                        Total Withdrawn
                    </th>
                    <th class="th-sm">
                        Total Offerwall Withdrawn
                    </th>
                    <th class="th-sm">
                        Link Shortner Earning
                    </th>
                    <th class="th-sm">
                        Bonus Ad Earning
                    </th>
                    <th class="th-sm">
                        Offerwall Earning
                    </th>
                    <th class="th-sm">
                        PTP Unique Earning
                    </th>
                    <th class="th-sm">
                        PTP Non-Unique 1 Earning
                    </th>
                    <th class="th-sm">
                        PTP Non-Unique 2 Earning
                    </th>
                    <th class="th-sm">
                        PTP Non-Unique 3 Earning
                    </th>
                    <th class="th-sm">
                        Last Login
                    </th>
                    <th class="th-sm">
                        Last Faucet Claim
                    </th>
                    <th class="th-sm">
                        Chat Banned ?
                    </th>
                    <th class="th-sm">
                        PTP Credit
                    </th>
                    <th class="th-sm">
                        PTP Day Credit
                    </th>
                    <th class="th-sm">
                        Banner Credit
                    </th>
                    <th class="th-sm">
                        Banner Day Credit
                    </th>
                    <th class="th-sm">
                        Bonus Ad Credit
                    </th>
                    <th class="th-sm">
                        Bonus Ad Day Credit
                    </th>
                </tr>
            </thead>
            <tbody id="tableBody"></tbody>
            <tfoot>
                <tr>
                    <th>
                        Username
                    </th>
                    <th>
                        Email
                    </th>
                    <th>
                        Email Confirmed
                    </th>
                    <th>
                        Date Registered
                    </th>
                    <th>
                        Registration IP
                    </th>
                    <th>
                        Country
                    </th>
                    <th>
                        FaucetHub Bitcoin Address
                    </th>
                    <th>
                        Account Locked
                    </th>
                    <th>
                        Cheat Counter
                    </th>
                    <th>
                        Referrer
                    </th>
                    <th>
                        Balance
                    </th>
                    <th>
                        Offerwall Balance
                    </th>
                    <th>
                        Purchase Balance
                    </th>
                    <th>
                        Total Withdrawn
                    </th>
                    <th>
                        Total Offerwall Withdrawn
                    </th>
                    <th>
                        Link Shortner Earning
                    </th>
                    <th>
                        Bonus Ad Earning
                    </th>
                    <th>
                        Offerwall Earning
                    </th>
                    <th>
                        PTP Unique Earning
                    </th>
                    <th>
                        PTP Non-Unique 1 Earning
                    </th>
                    <th>
                        PTP Non-Unique 2 Earning
                    </th>
                    <th>
                        PTP Non-Unique 3 Earning
                    </th>
                    <th>
                        Last Login
                    </th>
                    <th>
                        Last Faucet Claim
                    </th>
                    <th>
                        Chat Banned ?
                    </th>
                    <th>
                        PTP Credit
                    </th>
                    <th>
                        PTP Day Credit
                    </th>
                    <th>
                        Banner Credit
                    </th>
                    <th>
                        Banner Day Credit
                    </th>
                    <th>
                        Bonus Ad Credit
                    </th>
                    <th>
                        Bonus Ad Day Credit
                    </th>
                </tr>
            </tfoot>
        </table>

        <script>
            $(document).ready(function () {
                $('#dtBasicExample').DataTable();
                $('.dataTables_length').addClass('bs-select');
            });

            var tableData = JSON.parse(document.getElementById('tableData').innerHTML);

            for (i = 0; i < Object.keys(tableData[0]).length; i++) {

                document.getElementById("tableBody").insertAdjacentHTML('beforeend',
                    '<tr><td>' + `<a href='https://localhost:5001/Faucet4u/Referrals?username=${tableData[0][i].Username}' target="_blank">${tableData[0][i].Username}</a>` +
                    '</td><td>' + tableData[0][i].Email +
                    '</td><td>' + tableData[0][i].IsConfirmed +
                    '</td><td>' + moment(tableData[0][i].DateRegistered).format('YYYY-MM-DD - hh:mm:ss A') +
                    '</td><td>' + tableData[0][i].IP +
                    '</td><td>' + tableData[0][i].Country +
                    '</td><td>' + tableData[0][i].FaucetHubBitcoinAddress +
                    '</td><td>' + tableData[0][i].Locked +
                    '</td><td>' + tableData[0][i].CheatCounter +
                    '</td><td>' + tableData[0][i].Referrer +
                    '</td><td>' + tableData[0][i].Balance.toFixed(8) +
                    '</td><td>' + tableData[0][i].OfferwallBalance.toFixed(8) +
                    '</td><td>' + tableData[0][i].PurchaseBalance.toFixed(8) +
                    '</td><td>' + tableData[0][i].TotalWithdrawn.toFixed(8) +
                    '</td><td>' + tableData[0][i].TotalOfferwallWithdrawn.toFixed(8) +
                    '</td><td>' + tableData[0][i].LinkShortnerEarning.toFixed(8) +
                    '</td><td>' + tableData[0][i].BonusAdEarning.toFixed(8) +
                    '</td><td>' + tableData[0][i].OfferwallEarning.toFixed(8) +
                    '</td><td>' + tableData[0][i].PTPUniqueEarning.toFixed(8) +
                    '</td><td>' + tableData[0][i].PTPNonUnique1Earning.toFixed(8) +
                    '</td><td>' + tableData[0][i].PTPNonUnique2Earning.toFixed(8) +
                    '</td><td>' + tableData[0][i].PTPNonUnique3Earning.toFixed(8) +
                    '</td><td>' + moment(tableData[0][i].LastLogin).format('YYYY-MM-DD - hh:mm:ss A') +
                    '</td><td>' + moment(tableData[0][i].LastClaim).format('YYYY-MM-DD - hh:mm:ss A') +
                    '</td><td>' + tableData[0][i].ChatBanned +
                    '</td><td>' + tableData[0][i].PTPCredit +
                    '</td><td>' + tableData[0][i].PTPDayCredit +
                    '</td><td>' + tableData[0][i].BannerCredit +
                    '</td><td>' + tableData[0][i].BannerDayCredit +
                    '</td><td>' + tableData[0][i].BonusAdCredit +
                    '</td><td>' + tableData[0][i].BonusAdDayCredit +
                    '</td></tr>');

            }

        </script>


    </div>
    <div class="col-0"></div>
</div>


