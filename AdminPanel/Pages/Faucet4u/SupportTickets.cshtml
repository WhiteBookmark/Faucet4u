@page
@model AdminPanel.Pages.Faucet4u.SupportTicketModel
@{
    ViewData["Title"] = "SupportTicket";
    Layout = "Faucet4u_Layout";
}

<div class="row" style="margin-top: 10%;">
    <div class="col-1"></div>
    <div class="col text-center">
        <span class="text-success">@ViewData["Success"]</span>
        <span class="text-danger">@ViewData["Failed"]</span>
        <span class="text-danger">@ViewData["Error"]</span>
        <br />
        <!-- Support Ticket-- View-->
        <form asp-page-handler="ViewSupportTicket" target="_blank" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">View/Reply Page</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Reference</span>
                </div>
                <input type="text" class="form-control" placeholder="Reference" name="reference" aria-label="Reference" aria-describedby="basic-addon1">
            </div>
        </form>

        <!--Support Ticket-- Lock-->
        <form asp-page-handler="LockSupportTicket" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Lock</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Reference</span>
                </div>
                <input type="text" class="form-control" placeholder="Reference" name="reference" aria-label="Reference" aria-describedby="basic-addon1">
            </div>
        </form>


        <p hidden id="tableData">@ViewData["TableData"]</p>

        <table id="dtBasicExample" class="table table-striped table-bordered" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th class="th-sm">
                        Reference
                    </th>
                    <th class="th-sm">
                        Created
                    </th>
                    <th class="th-sm">
                        Username
                    </th>
                    <th class="th-sm">
                        Email
                    </th>
                    <th class="th-sm">
                        Subject
                    </th>
                    <th class="th-sm">
                        Read
                    </th>
                    <th class="th-sm">
                        Locked
                    </th>
                    <th class="th-sm">
                        Last Replier
                    </th>
                </tr>
            </thead>
            <tbody id="tableBody"></tbody>
            <tfoot>
                <tr>
                    <th>
                        Reference
                    </th>
                    <th>
                        Created
                    </th>
                    <th>
                        Username
                    </th>
                    <th>
                        Email
                    </th>
                    <th>
                        Subject
                    </th>
                    <th>
                        Read
                    </th>
                    <th>
                        Locked
                    </th>
                    <th>
                        Last Replier
                    </th>
                </tr>
            </tfoot>
        </table>

        <script>
            $(document).ready(function () {
                $('#dtBasicExample').DataTable();
                $('.dataTables_length').addClass('bs-select');
            });

            var tableData = JSON.parse(document.getElementById('tableData').innerHTML);

            for (i = 0; i < Object.keys(tableData).length; i++) {

                document.getElementById("tableBody").insertAdjacentHTML('beforeend',
                    '<tr><td class="clickableTableData" onClick="updateReferenceInput(this.innerHTML)">' + tableData[i].Reference +
                    '</td><td>' + moment(tableData[i].DateTime).format('YYYY-MM-DD - hh:mm:ss A') +
                    '</td><td>' + tableData[i].Username +
                    '</td><td>' + tableData[i].Email +
                    '</td><td>' + tableData[i].Subject +
                    '</td><td>' + tableData[i].Read +
                    '</td><td>' + tableData[i].Locked +
                    '</td><td>' + tableData[i].LastReplier +
                    '</td></tr>');

            }

            function updateReferenceInput(reference) {

                $('input[name=reference]').val(reference);
                window.scrollTo(0, 0);
            }
        </script>


    </div>
    <div class="col-1"></div>


</div>
