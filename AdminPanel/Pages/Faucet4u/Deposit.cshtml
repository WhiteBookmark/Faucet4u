                <div class="md-form input-group">
                    <div class="input-group-prepend">
                        <button class="btn btn-unique waves-effect m-0" type="submit">Add</button>
                    </div>
                    <div class="input-group-prepend">
                        <span class="input-group-text" id="basic-addon1">@@</span>
                    </div>
                    <input type="text" class="form-control" placeholder="Username" name="username" aria-label="Username" aria-describedby="basic-addon1">
                    <input type="text" class="form-control" placeholder="Wallet Type" name="type" aria-label="Type" aria-describedby="basic-addon1">
                    <input type="text" class="form-control" placeholder="Address" name="address" aria-label="Address" aria-describedby="basic-addon1">
                    <input type="number" class="form-control" placeholder="0.00000000" step="0.00000001" name="amount" aria-label="amount" aria-describedby="basic-addon1">
                    <input type="text" class="form-control" placeholder="Remarks (if any)" name="remarks" aria-label="Remarks" aria-describedby="basic-addon1">
                </div>
            </form>*@

        <!--Deposit History-- Delete -->
        @*<form asp-page-handler="DeleteDepositHistory" method="post">
                <div class="md-form input-group">
                    <div class="input-group-prepend">
                        <button class="btn btn-unique waves-effect m-0" type="submit">Delete</button>
                    </div>
                    <div class="input-group-prepend">
                        <span class="input-group-text" id="basic-addon1">Reference #</span>
                    </div>
                    <input type="text" class="form-control" placeholder="Reference" name="reference" aria-label="Reference" aria-describedby="basic-addon1">
                </div>
            </form>*@

        <p hidden id="tableData">@ViewData["TableData"]</p>

        <table id="dtBasicExample" class="table table-striped table-bordered" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th class="th-sm">
                        Reference
                    </th>
                    <th class="th-sm">
                        Deposit Date
                    </th>
                    <th class="th-sm">
                        Username
                    </th>
                    <th class="th-sm">
                        Amount
                    </th>
                    <th class="th-sm">
                        Wallet Address
                    </th>
                    <th class="th-sm">
                        Confirmations
                    </th>
                    <th class="th-sm">
                        Remarks
                    </th>
                </tr>
            </thead>
            <tbody id="tableBody"></tbody>
            <tfoot>
                <tr>
                    <th class="th-sm">
                        Reference
                    </th>
                    <th>
                        Deposit Date
                    </th>
                    <th>
                        Username
                    </th>
                    <th>
                        Amount
                    </th>
                    <th>
                        Wallet Address
                    </th>
                    <th>
                        Confirmations
                    </th>
                    <th>
                        Remarks
                    </th>
                </tr>
            </tfoot>
        </table>

        <script>
            $(document).ready(function () {
                $('#dtBasicExample').DataTable();
                $('.dataTables_length').addClass('bs-select');
            });

            var tableData = JSON.parse(document.getElementById('tableData').innerHTML);

            for (i = 0; i < Object.keys(tableData[0]).length; i++) {

                document.getElementById("tableBody").insertAdjacentHTML('beforeend',
                    '<tr><td>' + tableData[0][i].Reference +
                    '</td><td>' + moment(tableData[0][i].DepositDate).format('YYYY-MM-DD - hh:mm:ss A') +
                    '</td><td>' + tableData[0][i].Username +
                    '</td><td>' + tableData[0][i].Amount +
                    '</td><td>' + tableData[0][i].WalletAddress +
                    '</td><td>' + tableData[0][i].Confirmations +
                    '</td><td>' + tableData[0][i].Remarks +
                    '</td></tr>');

            }

        </script>


    </div>
    <div class="col-1"></div>
</div>


