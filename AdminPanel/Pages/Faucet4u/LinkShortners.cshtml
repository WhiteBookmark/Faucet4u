@page
@model AdminPanel.Pages.Faucet4u.LinkShortnersModel
@{
    ViewData["Title"] = "Link Shortners";
    Layout = "Faucet4u_Layout";
}

<div class="row" style="margin-top: 10%;">
    <div class="col-3"></div>
    <div class="col">
        <span class="text-success">@ViewData["Success"]</span>
        <span class="text-danger">@ViewData["Failed"]</span>
        <span class="text-danger">@ViewData["Error"]</span>
        <br />

        <!--Query all the API to check their results and see if there is any flaw -->
        <form asp-page-handler="QueryAll" method="post">
            <input type="text" hidden class="form-control" placeholder="Link" name="link" aria-label="Link" aria-describedby="basic-addon1">
            <button class="btn btn-unique waves-effect m-0" name="submit" type="submit">Query all API</button>
        </form>

        @{

            if (@ViewData["QueryAPIOriginal"] != null)
            {
                string[] listOriginal = @ViewData["QueryAPIOriginal"].ToString().Split("\n");

                foreach (string item in listOriginal)
                {
                    <span class="text-success font-weight-bold">@item</span><br />
                }
            }
        }

        @{

            if (@ViewData["QueryAPI"] != null)
            {
                string[] listQuery = @ViewData["QueryAPI"].ToString().Split("\n");

                foreach (string item in listQuery)
                {
                    <span class="text-warning font-weight-bold">@item</span><br />
                }
            }
        }

        <span class="text-info font-weight-bold">@ViewData["QueryAPIOriginalCount"]</span><br />
        <span class="text-info font-weight-bold">@ViewData["QueryAPICount"]</span><br />

        <!--Link Shortner-- Add -->
        <form asp-page-handler="AddLinkShortner" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Add</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Link</span>
                </div>
                <input type="text" class="form-control" placeholder="Link" name="link" aria-label="Link" aria-describedby="basic-addon1">
                <input type="number" class="form-control" placeholder="0" step="1" name="limit" aria-label="limit" aria-describedby="basic-addon1">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Limit</span>
                </div>
            </div>
        </form>

        <!--Link Shortner-- Replace -->
        <form asp-page-handler="ReplaceLinkShortner" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Replace</button>
                </div>
                <input type="text" class="form-control" placeholder="Id" name="id" aria-label="Id" aria-describedby="basic-addon1">
                <input type="text" class="form-control" placeholder="Link" name="link" aria-label="Link" aria-describedby="basic-addon1">
                <input type="number" class="form-control" placeholder="0" step="1" name="limit" aria-label="limit" aria-describedby="basic-addon1">
                <textarea type="text" id="remarks" placeholder="Write the note here" name="remarks" class="form-control" rows="3"></textarea>
            </div>
        </form>

        <!--Link Shortner-- Delete -->
        <form asp-page-handler="DeleteLinkShortner" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Delete</button>
                </div>
                <input type="text" class="form-control" placeholder="Id" name="id" aria-label="Id" aria-describedby="basic-addon1">
            </div>
        </form>


        <p hidden id="tableData">@ViewData["TableData"]</p>

        <table id="dtBasicExample" class="table table-striped table-bordered" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th class="th-sm">
                        Id
                    </th>
                    <th class="th-sm">
                        Link
                    </th>
                    <th class="th-sm">
                        Limit
                    </th>
                    <th class="th-sm">
                        Remarks
                    </th>
                </tr>
            </thead>
            <tbody id="tableBody"></tbody>
            <tfoot>
                <tr>
                    <th>
                        Id
                    </th>
                    <th>
                        Link
                    </th>
                    <th>
                        Limit
                    </th>
                    <th>
                        Remarks
                    </th>
                </tr>
            </tfoot>
        </table>

        <script>
            $(document).ready(function () {
                $('#dtBasicExample').DataTable({
                    pageLength: 100,
                    "order": [[2, "desc"]]
                });
                $('.dataTables_length').addClass('bs-select');
            });

            var tableData = JSON.parse(document.getElementById('tableData').innerHTML);

            for (i = 0; i < Object.keys(tableData).length; i++) {
                //Use innertext instead of innerHTML here because it will otherwise convert special characters into entity
                document.getElementById("tableBody").insertAdjacentHTML('beforeend',
                    '<tr><td class="clickableTableData" onClick="updateIdInput(this.innerText)">' + tableData[i].Id +
                    '</td><td class="clickableTableData" onClick="updateLinkInput(this.innerText)">' + tableData[i].Link +
                    '</td><td class="clickableTableData" onClick="updateLimitInput(this.innerText)">' + tableData[i].Limit +
                    '</td><td class="clickableTableData" onClick="updateRemarksInput(this.innerHTML)">' + tableData[i].Remarks +
                    '</td></tr>');

            }

            $('#tableBody').html($('#tableBody').html().replace(/\n/g, "<br />"));

            function updateIdInput(id) {

                $('input[name=id]').val(id);
                window.scrollTo(0, 0);
            }

            function updateLinkInput(link) {

                $('input[name=link]').val(link);
                window.scrollTo(0, 0);
            }

            function updateLimitInput(limit) {

                $('input[name=limit]').val(limit);
                window.scrollTo(0, 0);
            }

            function updateRemarksInput(remarks) {

                $('textarea[name=remarks]').val(remarks.replace(/<br\s*[\/]?>/gi, "\n"));
                window.scrollTo(0, 0);
            }
        </script>


    </div>
    <div class="col-3"></div>


</div>