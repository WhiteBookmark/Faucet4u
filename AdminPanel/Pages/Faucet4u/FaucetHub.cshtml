@page
@model AdminPanel.Pages.Faucet4u.FaucetHubModel
@{
    ViewData["Title"] = "FaucetHub";
    Layout = "Faucet4u_Layout";
}

<div class="row" style="margin-top: 10%;">
    <div class="col-1"></div>
    <div class="col">
        <span class="text-success">@ViewData["Success"]</span>
        <span class="text-danger">@ViewData["Failed"]</span>
        <span class="text-danger">@ViewData["Error"]</span>
        <br />

        <h2 class="font-weight-bold">FaucetHub bitcoin address: 39hqwQTnPCvqyi6q4ePojwzqcBvzXQiMS7</h2>
        <h2 class="font-weight-bold">FaucetHub bitcoin balance: <span id="balance"></span></h2>

        <p class="font-weight-bold">Deposits will be credited after 6 network confirmations.</p>
        <p class="font-weight-bold">There is a processing fee of 1.5% on all deposits.</p>
        <p class="font-weight-bold">Minimum deposit amount of 0.00025000 BTC.</p>

        <!-- Payment - Send-->
        <form asp-page-handler="SendPayment" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Send</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Address</span>
                </div>
                <input type="text" class="form-control" placeholder="Address" name="address" aria-label="Address" aria-describedby="basic-addon1">
                <input type="number" class="form-control" placeholder="0.00000000" step="0.00000001" name="amount" aria-label="amount" aria-describedby="basic-addon1">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Amount</span>
                </div>
            </div>

        </form>

        <p hidden id="tableData">@ViewData["TableData"]</p>

        <p class="bg-danger text-white">FaucetHub Transanction History: </p>

        <table id="dtBasicExample" class="table table-striped table-bordered" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th class="th-sm">
                        Date Time
                    </th>
                    <th class="th-sm">
                        Payout Id
                    </th>
                    <th class="th-sm">
                        Hash
                    </th>
                    <th class="th-sm">
                        Address
                    </th>
                    <th class="th-sm">
                        Amount
                    </th>
                </tr>
            </thead>
            <tbody id="tableBody"></tbody>
            <tfoot>
                <tr>
                    <th>
                        Date Time
                    </th>
                    <th>
                        Payout Id
                    </th>
                    <th>
                        Hash
                    </th>
                    <th>
                        Address
                    </th>
                    <th>
                        Amount
                    </th>
                </tr>
            </tfoot>
        </table>

        <script>
            $(document).ready(function () {
                $('#dtBasicExample').DataTable();
                $('.dataTables_length').addClass('bs-select');
            });

            var tableData = JSON.parse(document.getElementById('tableData').innerHTML);

            document.getElementById("balance").innerHTML = tableData[1].balance_bitcoin.toFixed(8);

            for (i = 0; i < Object.keys(tableData[0]).length; i++) {

                document.getElementById("tableBody").insertAdjacentHTML('beforeend',
                    '<tr><td>' + moment(tableData[0][i].DateTime).format('YYYY-MM-DD - hh:mm:ss A') +
                    '</td><td>' + tableData[0][i].PayoutId +
                    '</td><td>' + tableData[0][i].Hash +
                    '</td><td class="clickableTableData" onClick="updateAddressInput(this.innerHTML)">' + tableData[0][i].Address +
                    '</td><td class="clickableTableData" onClick="updateAmountInput(this.innerHTML)">' + tableData[0][i].Amount.toFixed(8) +
                    '</td></tr>');

            }

            function updateAddressInput(address) {

                $('input[name=address]').val(address);
                window.scrollTo(0, 0);
            }

            function updateAmountInput(amount) {

                $('input[name=amount]').val(amount);
                window.scrollTo(0, 0);
            }
        </script>

    </div>
    <div class="col-1"></div>
</div>
