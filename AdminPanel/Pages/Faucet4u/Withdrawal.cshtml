                    <input type="text" class="form-control" name="authy" aria-label="Authy" aria-describedby="basic-addon1">
                </div>

                <button class="btn btn-unique waves-effect m-0" type="submit">Approve</button>
            </form>

            <!-- Decline-->
            <form asp-page-handler="DeclineWithdrawal" method="post" class="border border-dark p-5">

                <div class="md-form input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text" id="basic-addon1">Reference</span>
                    </div>
                    <input type="text" class="form-control" placeholder="Reference #" name="reference" aria-label="Reference" aria-describedby="basic-addon1">
                </div>

                <div class="md-form input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text" id="basic-addon1">Remarks</span>
                    </div>
                    <input type="text" class="form-control" placeholder="Remarks (if any)" name="remarks" aria-label="Remarks" aria-describedby="basic-addon1">
                </div>

                <div class="md-form input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text" id="basic-addon1">2FA Code</span>
                    </div>
                    <input type="text" class="form-control" name="authy" aria-label="Authy" aria-describedby="basic-addon1">
                </div>

                <button class="btn btn-unique waves-effect m-0" type="submit">Decline</button>
            </form>*@

        <form asp-page-handler="ApproveWithdrawal" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Approve</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Reference</span>
                </div>
                <input type="text" class="form-control" placeholder="Reference #" name="reference" aria-label="Reference" aria-describedby="basic-addon1">
                <input type="text" class="form-control" placeholder="Remarks (if any)" name="remarks" aria-label="Remarks" aria-describedby="basic-addon1">
            </div>
        </form>

        <!-- Decline-->
        <form asp-page-handler="DeclineWithdrawal" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Decline</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Reference</span>
                </div>
                <input type="text" class="form-control" placeholder="Remarks (if any)" name="remarks" aria-label="Remarks" aria-describedby="basic-addon1">
            </div>
        </form>

    </div>
    <div class="col-3"></div>

</div>

<div class="row">
    <div class="col-1"></div>
    <div class="col">

        <p hidden id="tableData">@ViewData["TableData"]</p>

        <table id="dtBasicExample" class="table table-striped table-bordered" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th class="th-sm">
                        Reference
                    </th>
                    <th class="th-sm">
                        Withdrawal Type
                    </th>
                    <th class="th-sm">
                        Username
                    </th>
                    <th class="th-sm">
                        Requested Date
                    </th>
                    <th class="th-sm">
                        Requested Amount
                    </th>
                    <th class="th-sm">
                        Paid
                    </th>
                    <th class="th-sm">
                        Wallet Type
                    </th>
                    <th class="th-sm">
                        Wallet Address
                    </th>
                    <th class="th-sm">
                        Remarks
                    </th>
                    @*<th class="th-sm">
                            Approved by Ahmed
                        </th>
                        <th class="th-sm">
                            Approved by Suleman
                        </th>*@
                </tr>
            </thead>
            <tbody id="tableBody"></tbody>
            <tfoot>
                <tr>
                    <th>
                        Reference
                    </th>
                    <th>
                        Withdrawal Type
                    </th>
                    <th>
                        Username
                    </th>
                    <th>
                        Requested Date
                    </th>
                    <th>
                        Requested Amount
                    </th>
                    <th>
                        Paid
                    </th>
                    <th>
                        Wallet Type
                    </th>
                    <th>
                        Wallet Address
                    </th>
                    <th>
                        Remarks
                    </th>
                    @*<th>
                            Approved by Ahmed
                        </th>
                        <th>
                            Approved by Suleman
                        </th>*@
                </tr>
            </tfoot>
        </table>

        <script>
            $(document).ready(function () {
                $('#dtBasicExample').DataTable();
                $('.dataTables_length').addClass('bs-select');
            });

            var tableData = JSON.parse(document.getElementById('tableData').innerHTML);

            for (i = 0; i < Object.keys(tableData).length; i++) {

                document.getElementById("tableBody").insertAdjacentHTML('beforeend',
                    '<tr><td class="clickableTableData" onClick="updateReferenceInput(this.innerHTML)">' + tableData[i].Reference +
                    '</td><td>' + tableData[i].WithdrawalType +
                    '</td><td>' + tableData[i].Username +
                    '</td><td>' + moment(tableData[i].RequestedDate).format('YYYY-MM-DD - hh:mm:ss A') +
                    '</td><td>' + tableData[i].RequestedAmount.toFixed(8) +
                    '</td><td>' + tableData[i].Paid +
                    '</td><td>' + tableData[i].WalletType +
                    '</td><td>' + tableData[i].WalletAddress +
                    '</td><td class="clickableTableData" onClick="updateRemarksInput(this.innerHTML)">' + tableData[i].Remarks +
                    //'</td><td>' + tableData[i].Signature1 +
                    //'</td><td>' + tableData[i].Signature2 +
                    '</td></tr>');

            }

            function updateReferenceInput(reference) {

                $('input[name=reference]').val(reference);
                window.scrollTo(0, 0);
            }

            function updateRemarksInput(remarks) {

                $('input[name=remarks]').val(remarks);
                window.scrollTo(0, 0);
            }
        </script>

    </div>
    <div class="col-1"></div>

</div>

