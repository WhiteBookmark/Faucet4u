@page
@model AdminPanel.Pages.Faucet4u.BannerNetworkModel
@{
    ViewData["Title"] = "BannerNetwork";
    Layout = "Faucet4u_Layout";
}


<div class="row" style="margin-top: 10%;">
    <div class="col-3"></div>
    <div class="col">
        <span class="text-success">@ViewData["Success"]</span>
        <span class="text-danger">@ViewData["Failed"]</span>
        <span class="text-danger">@ViewData["Error"]</span>
        <br />
        <p class="bg-danger text-white">Standard Banners Only: </p>
        <br />
        <!-- BannerNetwork-- Add-->
        <form asp-page-handler="AddBannerNetwork" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Add</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">HTML Code</span>
                </div>
                <input type="text" class="form-control" placeholder="HTMLCode" name="HTMLCode" aria-label="HTMLCode" aria-describedby="basic-addon1">
            </div>
        </form>

        <!-- BannerNetwork-- Delete-->
        <form asp-page-handler="DeleteBannerNetwork" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Delete</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">ID Only</span>
                </div>
                <input type="text" class="form-control" placeholder="ID" name="id" aria-label="ID" aria-describedby="basic-addon1">
            </div>
        </form>


        <p hidden id="tableData">@ViewData["TableData"]</p>

        <table id="dtBasicExample" class="table table-striped table-bordered" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th class="th-sm">
                        Id
                    </th>
                    <th class="th-sm">
                        HTML Code
                    </th>
                </tr>
            </thead>
            <tbody id="tableBody"></tbody>
            <tfoot>
                <tr>
                    <th>
                        Id
                    </th>
                    <th>
                        HTML Code
                    </th>
                </tr>
            </tfoot>
        </table>

        <br />
        <p class="bg-danger text-white">Square Banners Only: </p>
        <br />

        <!-- SquareBannerNetwork-- Add-->
        <form asp-page-handler="AddSquareBannerNetwork" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Add</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">HTML Code</span>
                </div>
                <input type="text" class="form-control" placeholder="HTMLCode" name="HTMLCode" aria-label="HTMLCode" aria-describedby="basic-addon1">
            </div>
        </form>

        <!-- SquareBannerNetwork-- Delete-->
        <form asp-page-handler="DeleteSquareBannerNetwork" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Delete</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">ID Only</span>
                </div>
                <input type="text" class="form-control" placeholder="ID" name="id" aria-label="ID" aria-describedby="basic-addon1">
            </div>
        </form>

        <table id="dtBasicExample2" class="table table-striped table-bordered" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th class="th-sm">
                        Id
                    </th>
                    <th class="th-sm">
                        HTML Code
                    </th>
                </tr>
            </thead>
            <tbody id="tableBody2"></tbody>
            <tfoot>
                <tr>
                    <th>
                        Id
                    </th>
                    <th>
                        HTML Code
                    </th>
                </tr>
            </tfoot>
        </table>

        <br />
        <p class="bg-danger text-white">Skyscraper Banners Only: </p>
        <br />

        <!-- SkyscraperBannerNetwork-- Add-->
        <form asp-page-handler="AddSkyscraperBannerNetwork" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Add</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">HTML Code</span>
                </div>
                <input type="text" class="form-control" placeholder="HTMLCode" name="HTMLCode" aria-label="HTMLCode" aria-describedby="basic-addon1">
            </div>
        </form>

        <!-- SkyscraperBannerNetwork-- Delete-->
        <form asp-page-handler="DeleteSkyscraperBannerNetwork" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Delete</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">ID Only</span>
                </div>
                <input type="text" class="form-control" placeholder="ID" name="id" aria-label="ID" aria-describedby="basic-addon1">
            </div>
        </form>

        <table id="dtBasicExample3" class="table table-striped table-bordered" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th class="th-sm">
                        Id
                    </th>
                    <th class="th-sm">
                        HTML Code
                    </th>
                </tr>
            </thead>
            <tbody id="tableBody3"></tbody>
            <tfoot>
                <tr>
                    <th>
                        Id
                    </th>
                    <th>
                        HTML Code
                    </th>
                </tr>
            </tfoot>
        </table>


        <script>
            $(document).ready(function () {
                $('#dtBasicExample').DataTable();
                $('#dtBasicExample2').DataTable();
                $('#dtBasicExample3').DataTable();
                $('.dataTables_length').addClass('bs-select');
            });

            var tableData = JSON.parse(document.getElementById('tableData').innerHTML);

            for (i = 0; i < Object.keys(tableData[0]).length; i++) {

                document.getElementById("tableBody").insertAdjacentHTML('beforeend',
                    '<tr><td class="clickableTableData" onClick="updateIdInput(this.innerHTML)">' + tableData[0][i].Id +
                    '</td><td class="clickableTableData" onClick="updateHTMLCodeInput(this.innerHTML)">' + tableData[0][i].HTMLCode +
                    '</td></tr>');

            }
            for (i = 0; i < Object.keys(tableData[1]).length; i++) {

                document.getElementById("tableBody2").insertAdjacentHTML('beforeend',
                    '<tr><td class="clickableTableData" onClick="updateIdInput(this.innerHTML)">' + tableData[1][i].Id +
                    '</td><td class="clickableTableData" onClick="updateHTMLCodeInput(this.innerHTML)">' + tableData[1][i].HTMLCode +
                    '</td></tr>');

            }
            for (i = 0; i < Object.keys(tableData[2]).length; i++) {

                document.getElementById("tableBody3").insertAdjacentHTML('beforeend',
                    '<tr><td class="clickableTableData" onClick="updateIdInput(this.innerHTML)">' + tableData[2][i].Id +
                    '</td><td class="clickableTableData" onClick="updateHTMLCodeInput(this.innerHTML)">' + tableData[2][i].HTMLCode +
                    '</td></tr>');

            }

            function updateIdInput(id) {

                $('input[name=id]').val(id);
                window.scrollTo(0, 0);
            }

            function updateHTMLCodeInput(HTMLCode) {

                $('input[name=HTMLCode]').val(HTMLCode);
                window.scrollTo(0, 0);
            }

        </script>

    </div>
    <div class="col-3"></div>


</div>


