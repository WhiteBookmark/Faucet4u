@page
@model AdminPanel.Pages.Faucet4u.BonusAdsModel
@{
    ViewData["Title"] = "BonusAds";
    Layout = "Faucet4u_Layout";
}


<div class="row" style="margin-top: 10%;">
    <div class="col-3"></div>
    <div class="col">
        <span class="text-success">@ViewData["Success"]</span>
        <span class="text-danger">@ViewData["Failed"]</span>
        <span class="text-danger">@ViewData["Error"]</span>
        <br />
        <!--Bonus Ads-- Add -->
        <form asp-page-handler="AddBonusAd" method="post" class="border border-dark p-5">

            <h3>Time based: 1 Credit = 1 Day</h3>
            <h3>Hits based: 1 Credit = 1 Hit</h3>

            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Is this package time based ?</span>
                </div>
                <select class="browser-default custom-select" id="inputGroupSelect01" name="isTimeBased">
                    <option value="1" selected>Yes</option>
                    <option value="0">No</option>
                </select>
            </div>

            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Credit</span>
                </div>
                <input type="number" class="form-control" placeholder="0" step="1" name="credit" aria-label="credit" aria-describedby="basic-addon1">
            </div>

            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Target link</span>
                </div>
                <input type="text" class="form-control" placeholder="Write the link here" name="link" aria-label="link" aria-describedby="basic-addon1">
            </div>

            <input hidden type="number" class="form-control" placeholder="0" value="1" step="1" name="limit" aria-label="limit" aria-describedby="basic-addon1">

            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Title (Optional)</span>
                </div>
                <input type="text" class="form-control" maxlength="20" placeholder="Ad title" name="title" aria-label="title" aria-describedby="basic-addon1">
            </div>

            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Description (Optional)</span>
                </div>
                <input type="text" class="form-control" maxlength="50" placeholder="Ad description" name="description" aria-label="description" aria-describedby="basic-addon1">
            </div>

            <button class="btn btn-unique waves-effect m-0" type="submit">Add</button>
        </form>

        <!-- Bonus Ad-- Update-->
        <form asp-page-handler="UpdateBonusAd" method="post" class="border border-dark p-5">

            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Id</span>
                </div>
                <input type="text" class="form-control" placeholder="ID" name="id" aria-label="ID" aria-describedby="basic-addon1">
            </div>

            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Link</span>
                </div>
                <input type="text" class="form-control" placeholder="Write the link here" name="link" aria-label="link" aria-describedby="basic-addon1">
            </div>

            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Title</span>
                </div>
                <input type="text" class="form-control" placeholder="Write the title here" maxlength="20" name="title" aria-label="title" aria-describedby="basic-addon1">
            </div>

            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Description</span>
                </div>
                <input type="text" class="form-control" placeholder="Write the description here" maxlength="50" name="description" aria-label="description" aria-describedby="basic-addon1">
            </div>

            <button class="btn btn-unique waves-effect m-0" type="submit">Update</button>
        </form>

        <!-- Bonus Ad-- Credit Update-->
        <form asp-page-handler="UpdateCreditBonusAd" method="post" class="border border-dark p-5">

            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Id</span>
                </div>
                <input type="text" class="form-control" placeholder="ID" name="id" aria-label="ID" aria-describedby="basic-addon1">
            </div>

            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Credit</span>
                </div>
                <input type="number" class="form-control" placeholder="0" step="1" name="credit" aria-label="credit" aria-describedby="basic-addon1">
            </div>

            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Credits</span>
                </div>
                <select class="browser-default custom-select" id="inputGroupSelect02" name="creditAction">
                    <option value="Add" selected>Add</option>
                    <option value="Retract">Retract</option>
                    <option value="Replace">Replace</option>
                </select>
            </div>

            <button class="btn btn-unique waves-effect m-0" type="submit">Add/Retract/Replace Credits</button>
        </form>

        <!--Bonus Ad-- Delete -->
        <form asp-page-handler="DeleteBonusAd" method="post" class="border border-dark p-5">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Delete</button>
                </div>
                <input type="text" class="form-control" placeholder="Id" name="id" aria-label="id" aria-describedby="basic-addon1">
            </div>
        </form>


        <p hidden id="tableData">@ViewData["TableData"]</p>

    </div>
    <div class="col-3"></div>
</div>

<div class="row" style="margin-top: 10%;">
    <div class="col-1"></div>
    <div class="col">

        <table id="dtBasicExample" class="table table-striped table-bordered" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th class="th-sm">
                        Id
                    </th>
                    <th class="th-sm">
                        Creation
                    </th>
                    <th class="th-sm">
                        Username
                    </th>
                    <th class="th-sm">
                        Link
                    </th>
                    <th class="th-sm">
                        Is this package time based ?
                    </th>
                    <th class="th-sm">
                        Hits Received
                    </th>
                    <th class="th-sm">
                        Credit
                    </th>
                    <th class="th-sm">
                        Title
                    </th>
                    <th class="th-sm">
                        Description
                    </th>
                </tr>
            </thead>
            <tbody id="tableBody"></tbody>
            <tfoot>
                <tr>
                    <th>
                        Id
                    </th>
                    <th>
                        Creation
                    </th>
                    <th>
                        Username
                    </th>
                    <th>
                        Link
                    </th>
                    <th>
                        Is this package time based ?
                    </th>
                    <th>
                        Hits Received
                    </th>
                    <th>
                        Credit
                    </th>
                    <th>
                        Title
                    </th>
                    <th>
                        Description
                    </th>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="col-1"></div>
</div>

<script>
    $(document).ready(function () {
        $('#dtBasicExample').DataTable();
        $('.dataTables_length').addClass('bs-select');
    });

    var tableData = JSON.parse(document.getElementById('tableData').innerHTML);

    for (i = 0; i < Object.keys(tableData[0]).length; i++) {

        document.getElementById("tableBody").insertAdjacentHTML('beforeend',

            '<tr><td class="clickableTableData" onClick="updateIdInput(this.innerHTML)">' + tableData[0][i].Id +
            '</td><td>' + moment(tableData[0][i].Creation).format('YYYY-MM-DD - hh:mm:ss A') +
            '</td><td>' + tableData[0][i].Username +
            '</td><td class="clickableTableData" onClick="updateLinkInput(this.innerHTML)">' + tableData[0][i].Link +
            '</td><td>' + tableData[0][i].IsTimeBased +
            '</td><td>' + tableData[0][i].HitsReceived +
            '</td><td class="clickableTableData" onClick="updateCreditInput(this.innerHTML)">' + tableData[0][i].Credit +
            '</td><td class="clickableTableData" onClick="updateTitleInput(this.innerHTML)">' + tableData[0][i].Title +
            '</td><td class="clickableTableData" onClick="updateDescriptionInput(this.innerHTML)">' + tableData[0][i].Description +
            '</td></tr>');

    }

    function updateIdInput(id) {

        $('input[name=id]').val(id);
        window.scrollTo(0, 0);
    }

    function updateLinkInput(link) {

        $('input[name=link]').val(link);
        window.scrollTo(0, 0);
    }

    function updateCreditInput(credit) {

        $('input[name=credit]').val(credit);
        window.scrollTo(0, 0);
    }

    function updateTitleInput(title) {

        $('input[name=title]').val(title);
        window.scrollTo(0, 0);
    }

    function updateDescriptionInput(description) {

        $('input[name=description]').val(description);
        window.scrollTo(0, 0);
    }

</script>