@page
@model AdminPanel.Pages.Faucet4u.ProfileModel
@{
    ViewData["Title"] = "Profile";
    Layout = "Faucet4u_Layout";
}

<div class="row" style="margin-top: 10%;">
    <div class="col-3"></div>
    <div class="col">
        <span class="text-success">@ViewData["Success"]</span>
        <span class="text-danger">@ViewData["Failed"]</span>
        <span class="text-danger">@ViewData["Error"]</span>
        <br />

        <!-- Replace Email -->
        <form asp-page-handler="ReplaceEmail" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Replace</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">@@</span>
                </div>
                <input type="text" class="form-control" placeholder="Username" name="username" aria-label="Username" aria-describedby="basic-addon1">
                <input type="Email" class="form-control" placeholder="example@yahoo.com" name="email" aria-label="email" aria-describedby="basic-addon1">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Email</span>
                </div>
            </div>
        </form>

        <br />

        <!--FaucetHubBitcoinAddress -- Replace -->
        <form asp-page-handler="ReplaceFaucetHubBitcoinAddress" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Replace</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">@@</span>
                </div>
                <input type="text" class="form-control" placeholder="Username" name="username" aria-label="Username" aria-describedby="basic-addon1">
                <input type="text" class="form-control" name="faucetHubBitcoinAddress" aria-label="FaucetHubBitcoinAddress" aria-describedby="basic-addon1">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">FaucetHubBitcoinAddress</span>
                </div>
            </div>

        </form>

        <p hidden id="tableData">@ViewData["TableData"]</p>

        <table id="dtBasicExample" class="table table-striped table-bordered" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th class="th-sm">
                        Username
                    </th>
                    <th class="th-sm">
                        Email
                    </th>
                    <th class="th-sm">
                        FaucetHub Bitcoin Address
                    </th>
                </tr>
            </thead>
            <tbody id="tableBody"></tbody>
            <tfoot>
                <tr>
                    <th>
                        Username
                    </th>
                    <th>
                        Email
                    </th>
                    <th>
                        FaucetHub Bitcoin Address
                    </th>
                </tr>
            </tfoot>
        </table>

        <script>
            $(document).ready(function () {
                $('#dtBasicExample').DataTable();
                $('.dataTables_length').addClass('bs-select');
            });

            var tableData = JSON.parse(document.getElementById('tableData').innerHTML);

            for (i = 0; i < Object.keys(tableData).length; i++) {

                document.getElementById("tableBody").insertAdjacentHTML('beforeend',
                    '<tr><td class="clickableTableData" onClick="updateUsernameInput(this.innerHTML)">' + tableData[i].Username +
                    '</td><td class="clickableTableData" onClick="updateEmailInput(this.innerHTML)">' + tableData[i].Email +
                    '</td><td class="clickableTableData" onClick="updateAddressInput(this.innerHTML)">' + tableData[i].FaucetHubBitcoinAddress +
                    '</td></tr>');

            }

            function updateUsernameInput(username) {

                $('input[name=username]').val(username);
                window.scrollTo(0, 0);
            }

            function updateEmailInput(email) {

                $('input[name=email]').val(email);
                window.scrollTo(0, 0);
            }

            function updateAddressInput(address) {

                $('input[name=address]').val(address);
                window.scrollTo(0, 0);
            }
        </script>


    </div>
    <div class="col-3"></div>
</div>

