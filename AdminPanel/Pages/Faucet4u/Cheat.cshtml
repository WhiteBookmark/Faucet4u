@page
@model AdminPanel.Pages.Faucet4u.CheatModel
@{
    ViewData["Title"] = "Cheat";
    Layout = "Faucet4u_Layout";
}

<div class="row" style="margin-top: 10%;">
    <div class="col-3"></div>
    <div class="col">
        <span class="text-success">@ViewData["Success"]</span>
        <span class="text-danger">@ViewData["Failed"]</span>
        <span class="text-danger">@ViewData["Error"]</span>
        <br />
        <!--Cheat Counter-- Add -->
        <form asp-page-handler="AddCheatCounter" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Add</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">@@</span>
                </div>
                <input type="text" class="form-control" placeholder="Username" name="username" aria-label="Username" aria-describedby="basic-addon1">
                <input type="number" class="form-control" placeholder="0" step="1" name="amount" aria-label="amount" aria-describedby="basic-addon1">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Cheat Counter</span>
                </div>
            </div>
        </form>

        <!--Cheat Counter-- Retract -->
        <form asp-page-handler="RetractCheatCounter" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Retract</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">@@</span>
                </div>
                <input type="text" class="form-control" placeholder="Username" name="username" aria-label="Username" aria-describedby="basic-addon1">
                <input type="number" class="form-control" placeholder="0" step="1" name="amount" aria-label="amount" aria-describedby="basic-addon1">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Cheat Counter</span>
                </div>
            </div>

        </form>

        <!--Cheat Counter-- Replace -->
        <form asp-page-handler="ReplaceCheatCounter" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Replace</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">@@</span>
                </div>
                <input type="text" class="form-control" placeholder="Username" name="username" aria-label="Username" aria-describedby="basic-addon1">
                <input type="number" class="form-control" placeholder="0" step="1" name="amount" aria-label="amount" aria-describedby="basic-addon1">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Cheat Counter</span>
                </div>
            </div>

        </form>

        <!--Lock -->
        <form asp-page-handler="Lock" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Lock Account</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">@@</span>
                </div>
                <input type="text" class="form-control" placeholder="Username" name="username" aria-label="Username" aria-describedby="basic-addon1">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Lock Account</span>
                </div>
            </div>

        </form>

        <!--Unlock -->
        <form asp-page-handler="Unlock" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Unlock Account</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">@@</span>
                </div>
                <input type="text" class="form-control" placeholder="Username" name="username" aria-label="Username" aria-describedby="basic-addon1">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Unlock Account</span>
                </div>
            </div>

        </form>


        <p hidden id="tableData">@ViewData["TableData"]</p>

        <table id="dtBasicExample" class="table table-striped table-bordered" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th class="th-sm">
                        Username
                    </th>
                    <th class="th-sm">
                        Cheat Counter
                    </th>
                    <th class="th-sm">
                        Account Locked
                    </th>
                </tr>
            </thead>
            <tbody id="tableBody"></tbody>
            <tfoot>
                <tr>
                    <th>
                        Username
                    </th>
                    <th>
                        Cheat Counter
                    </th>
                    <th>
                        Account Locked
                    </th>
                </tr>
            </tfoot>
        </table>

        <!--Cheat History -- Clear -->
        <form asp-page-handler="ClearCheatHistory" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Clear All History</button>
                </div>
            </div>
        </form>

        <p class="bg-danger text-white">Cheat history: </p>

        <table id="dtBasicExample2" class="table table-striped table-bordered" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th class="th-sm">
                        Reference
                    </th>
                    <th class="th-sm">
                        Date Time
                    </th>
                    <th class="th-sm">
                        Username
                    </th>
                    <th class="th-sm">
                        Cheat Level
                    </th>
                    <th class="th-sm">
                        Reason
                    </th>
                </tr>
            </thead>
            <tbody id="tableBody2"></tbody>
            <tfoot>
                <tr>
                    <th>
                        Reference
                    </th>
                    <th>
                        Date Time
                    </th>
                    <th>
                        Username
                    </th>
                    <th>
                        Cheat Level
                    </th>
                    <th>
                        Reason
                    </th>
                </tr>
            </tfoot>
        </table>

        <script>
            $(document).ready(function () {
                $('#dtBasicExample').DataTable();
                $('#dtBasicExample2').DataTable();
                $('.dataTables_length').addClass('bs-select');
            });

            var tableData = JSON.parse(document.getElementById('tableData').innerHTML);

            for (i = 0; i < Object.keys(tableData[0]).length; i++) {

                document.getElementById("tableBody").insertAdjacentHTML('beforeend',
                    '<tr><td class="clickableTableData" onClick="updateUsernameInput(this.innerHTML)">' + tableData[0][i].Username +
                    '</td><td class="clickableTableData" onClick="updateAmountInput(this.innerHTML)">' + tableData[0][i].CheatCounter +
                    '</td><td>' + tableData[0][i].Locked +
                    '</td></tr>');

            }
            for (i = 0; i < Object.keys(tableData[1]).length; i++) {

                document.getElementById("tableBody2").insertAdjacentHTML('beforeend',
                    '<tr><td>' + tableData[1][i].Reference +
                    '</td><td>' + moment(tableData[1][i].DateTime).format('YYYY-MM-DD - hh:mm:ss A') +
                    '</td><td class="clickableTableData" onClick="updateUsernameInput(this.innerHTML)">' + tableData[1][i].Username +
                    '</td><td class="clickableTableData" onClick="updateAmountInput(this.innerHTML)">' + tableData[1][i].CheatLevel +
                    '</td><td>' + tableData[1][i].Reason +
                    '</td></tr>');

            }

            function updateUsernameInput(username) {

                $('input[name=username]').val(username);
                window.scrollTo(0, 0);
            }

            function updateAmountInput(amount) {

                $('input[name=amount]').val(amount);
                window.scrollTo(0, 0);
            }
        </script>


    </div>
    <div class="col-3"></div>
</div>

