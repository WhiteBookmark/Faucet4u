@page
@model AdminPanel.Pages.Faucet4u.OrdersModel
@{
    ViewData["Title"] = "Orders";
    Layout = "Faucet4u_Layout";
}


<div class="row" style="margin-top: 10%;">
    <div class="col-1"></div>
    <div class="col">
        <span class="text-success">@ViewData["Success"]</span>
        <span class="text-danger">@ViewData["Failed"]</span>
        <span class="text-danger">@ViewData["Error"]</span>
        <br />
        <p class="bg-danger text-white">
            Please note: Rejecting an order will also refund the money deducted from their purchase balance.
        </p>

        <!--Order -- Approve -->
        <form asp-page-handler="ApproveOrder" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Approve</button>
                </div>
                <input type="text" class="form-control" placeholder="Reference #" name="reference" aria-label="reference" aria-describedby="basic-addon1">
                <input type="text" class="form-control" placeholder="Comment if you want" name="remarks" aria-label="remarks" aria-describedby="basic-addon1">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Remarks</span>
                </div>
            </div>

        </form>

        <!--Order -- Reject -->
        <form asp-page-handler="RejectOrder" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Reject</button>
                </div>
                <input type="text" class="form-control" placeholder="Reference #" name="reference" aria-label="reference" aria-describedby="basic-addon1">
                <input type="text" class="form-control" placeholder="Comment if you want" name="remarks" aria-label="remarks" aria-describedby="basic-addon1">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Remarks</span>
                </div>
            </div>

        </form>

        <p hidden id="tableData">@ViewData["TableData"]</p>

        <table id="dtBasicExample" class="table table-striped table-bordered" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th class="th-sm">
                        Reference
                    </th>
                    <th class="th-sm">
                        Purchase Date
                    </th>
                    <th class="th-sm">
                        Package Name
                    </th>
                    <th class="th-sm">
                        Package Value
                    </th>
                    <th class="th-sm">
                        Package Price
                    </th>
                    <th class="th-sm">
                        Username
                    </th>
                    <th class="th-sm">
                        Status
                    </th>
                    <th class="th-sm">
                        Image Link
                    </th>
                    <th class="th-sm">
                        Target Link
                    </th>
                    <th class="th-sm">
                        Remarks
                    </th>
                </tr>
            </thead>
            <tbody id="tableBody"></tbody>
            <tfoot>
                <tr>
                    <th>
                        Reference
                    </th>
                    <th>
                        Purchase Date
                    </th>
                    <th>
                        Package Name
                    </th>
                    <th>
                        Package Value
                    </th>
                    <th>
                        Package Price
                    </th>
                    <th>
                        Username
                    </th>
                    <th>
                        Status
                    </th>
                    <th>
                        Image Link
                    </th>
                    <th>
                        Target Link
                    </th>
                    <th>
                        Remarks
                    </th>
                </tr>
            </tfoot>
        </table>

        <script>
            $(document).ready(function () {
                $('#dtBasicExample').DataTable();
                $('.dataTables_length').addClass('bs-select');
            });

            var tableData = JSON.parse(document.getElementById('tableData').innerHTML);
            var rowNumber = 0;

            for (i = 0; i < Object.keys(tableData[rowNumber]).length; i++) {

                document.getElementById("tableBody").insertAdjacentHTML('beforeend', '<tr><td>' + tableData[rowNumber][i].Reference + '</td><td>' + moment(tableData[rowNumber][i].OrderDateTime).format('YYYY-MM-DD - hh:mm:ss A') + '</td><td>' + tableData[rowNumber][i].Name + '</td><td>' + tableData[rowNumber][i].Value + '</td><td>' + tableData[rowNumber][i].Price + '</td><td>' + tableData[rowNumber][i].Username + '</td><td>' + tableData[rowNumber][i].Status + '</td><td>' + tableData[rowNumber][i].ImageLink + '</td><td>' + tableData[rowNumber][i].TargetLink + '</td><td>' + tableData[rowNumber][i].Remarks + '</td></tr>');

            }

        </script>

    </div>
    <div class="col-1"></div>
</div>


