@page
@model AdminPanel.Pages.Faucet4u.ChatHistoryModel
@{
    ViewData["Title"] = "ChatHistory";
    Layout = "Faucet4u_Layout";
}


<div class="row" style="margin-top: 10%;">
    <div class="col-3"></div>
    <div class="col">
        <span class="text-success">@ViewData["Success"]</span>
        <span class="text-danger">@ViewData["Failed"]</span>
        <span class="text-danger">@ViewData["Error"]</span>
        <br />
        <!--Chat Message-- Delete -->
        <form asp-page-handler="DeleteChatMessage" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Delete</button>
                </div>
                <input type="text" class="form-control" placeholder="Reference" name="reference" aria-label="Reference" aria-describedby="basic-addon1">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Reference</span>
                </div>
            </div>
        </form>

        <!--Chat Message-- Ban -->
        <form asp-page-handler="BanChatUser" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">Ban</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">@@</span>
                </div>
                <input type="text" class="form-control" placeholder="Username" name="username" aria-label="Username" aria-describedby="basic-addon1">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Username</span>
                </div>
            </div>
        </form>

        <!--Chat Message-- UnBan -->
        <form asp-page-handler="UnBanChatUser" method="post">
            <div class="md-form input-group">
                <div class="input-group-prepend">
                    <button class="btn btn-unique waves-effect m-0" type="submit">UnBan</button>
                </div>
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">@@</span>
                </div>
                <input type="text" class="form-control" placeholder="Username" name="username" aria-label="Username" aria-describedby="basic-addon1">
                <div class="input-group-prepend">
                    <span class="input-group-text" id="basic-addon1">Username</span>
                </div>
            </div>
        </form>

        <p hidden id="tableData">@ViewData["TableData"]</p>

        <p class="bg-danger text-white">Note: You can delete any chat message from history or ban a user accessing chat box using above buttons.</p>
        <p class="bg-danger text-white">Chat History: </p>

        <table id="dtBasicExample" class="table table-striped table-bordered" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th class="th-sm">
                        Reference
                    </th>
                    <th class="th-sm">
                        Date Time
                    </th>
                    <th class="th-sm">
                        Username
                    </th>
                    <th class="th-sm">
                        Message
                    </th>
                </tr>
            </thead>
            <tbody id="tableBody"></tbody>
            <tfoot>
                <tr>
                    <th>
                        Reference
                    </th>
                    <th>
                        Date Time
                    </th>
                    <th>
                        Username
                    </th>
                    <th>
                        Message
                    </th>
                </tr>
            </tfoot>
        </table>

        <p class="bg-danger text-white">Users banned from using chat box: </p>

        <table id="dtBasicExample2" class="table table-striped table-bordered" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th class="th-sm">
                        Username
                    </th>
                    <th class="th-sm">
                        Chat Banned
                    </th>
                </tr>
            </thead>
            <tbody id="tableBody2"></tbody>
            <tfoot>
                <tr>
                    <th>
                        Username
                    </th>
                    <th>
                        Chat Banned
                    </th>
                </tr>
            </tfoot>
        </table>

        <script>

            var socket = io('http://127.0.0.1:3000');
            const outdatedSocketKey = "uX3e4y^Po8Yi";
            socket.emit('updateAllUserData', outdatedSocketKey);

            $(document).ready(function () {
                $('#dtBasicExample').DataTable();
                $('#dtBasicExample2').DataTable();
                $('.dataTables_length').addClass('bs-select');
            });

            var tableData = JSON.parse(document.getElementById('tableData').innerHTML);

            for (i = 0; i < Object.keys(tableData[0]).length; i++) {

                document.getElementById("tableBody").insertAdjacentHTML('beforeend',
                    '<tr><td class="clickableTableData" onClick="updateReferenceInput(this.innerHTML)">' + tableData[0][i].Reference +
                    '</td><td>' + moment(tableData[0][i].DateTime).format('YYYY-MM-DD - hh:mm:ss A') +
                    '</td><td class="clickableTableData" onClick="updateUsernameInput(this.innerHTML)">' + tableData[0][i].Username +
                    '</td><td>' + tableData[0][i].Message + '</td></tr>');

            }

            for (i = 0; i < Object.keys(tableData[1]).length; i++) {

                document.getElementById("tableBody2").insertAdjacentHTML('beforeend',
                    '<tr><td class="clickableTableData" onClick="updateUsernameInput(this.innerHTML)">' + tableData[1][i].Username +
                    '</td><td>' + tableData[1][i].ChatBanned +
                    '</td></tr>');

            }

            function updateReferenceInput(reference) {

                $('input[name=reference]').val(reference);
                window.scrollTo(0, 0);
            }

            function updateUsernameInput(username) {

                $('input[name=username]').val(username);
                window.scrollTo(0, 0);
            }
        </script>


    </div>
    <div class="col-3"></div>
</div>


